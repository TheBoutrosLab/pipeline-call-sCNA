// EXECUTION SETTINGS AND GLOBAL DEFAULTS

// External config files import. DO NOT MODIFY THESE LINES!
includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

/**
*   Pipeline parameters
*/

params {
    dataset_id = ""

    // Specify the genome build for the input BAMs. GRCh37 or GRCh38
    genome_build = "GRCh38"

    // Specify `target_bed` for Targeted Sequencing
    // `target_bed` is only applied to `cnv_facets`
    // target_bed = ""

    algorithm = [] // algorithm = ['Battenberg', 'cnv_facets']

    // Battenberg params
    genetic_sex = "XY" // "XY" or "XX"
    battenberg_reference = "/path/to/Battenberg/download_202204/GRCh38/battenberg_ref_hg38_chr/"
    // Specify custom min/max for purity (rho) and ploidy (psi)
    min_rho = 0.1
    max_rho = 1.0
    min_psi = 1.6
    max_psi = 4.8
    min_goodness_of_fit = 0.63
    balanced_threshold = 0.51
    min_normal_depth = 10
    min_base_qual = 20
    min_map_qual = 35

    // cnv_facets params
    dbSNP_file = "/path/to/RecSNV/GRCh38/dbsnp_b150_grch38.vcf.gz"
    snp_mapq = 1
    snp_baq = 30
    depth = [25, 2500]
    cval = [25, 400]
    nbhdsnp = 250
    rnd_seed = 0
    no_cov_plot = true // setting this option to false could be memory intensive and has not been tested yet
    snp_count_orphans = true

    // BAF/LogR - BPG plot params for whole sample plotting
    // "index" - alleles plotted serially; "genome-position" - alleles plotted respective to genomic position
    position_scale = "genome-position" //"index" or "genome-position"

    output_dir = "/path/to/output/dir/"

    bpg_plot_resolution = 200
    reference_dict = "/path/to/GRCh38-BI-20160721/Homo_sapiens_assembly38.dict"

    // CNA Signatures parameters
    exome = false
    min_max_signatures = [1, 25]
    nmf_replicates = 100
    resample = true
    seeds = "random"
    matrix_normalization = "gmm"
    nmf_init = "random"
    precision = "single"
    min_max_nmf_iterations = [10000, 1000000]
    nmf_test_cov = 10000
    nmf_tolerance = 1e-15
    batch_size = 1
    get_all_signature_matrices = false

    save_intermediate_files = false

    verbose = false

    // Base resource allocation updater
    // See README for adding parameters to update the base resource allocations
}

// Setup the pipeline config. DO NOT REMOVE THIS LINE!
methods.setup()
