// EXECUTION SETTINGS AND GLOBAL DEFAULTS

// External config files import. DO NOT MODIFY THIS LINE!
includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

// Inputs/parameters of the pipeline
params {
    dataset_id = "TWGSAMIN000001"

    blcds_registered_dataset = false

    // Specify the genome build for the input BAMs. GRCh37 or GRCh38
    genome_build = "GRCh38"

    algorithm = ['cnv_facets']

    // Battenberg params
    sample_sex = "male" // "male" or "female"
    battenberg_reference = "/hot/resource/tool-specific-input/Battenberg/download_202204/GRCh38/battenberg_ref_hg38_chr/"
    min_rho = 0.1
    max_rho = 1.0
    min_psi = 1.6
    max_psi = 4.8
    min_goodness_of_fit = 0.63
    balanced_threshold = 0.51
    min_normal_depth = 10
    min_base_qual = 20
    min_map_qual = 35

    // cnv_facets params
    dbSNP_file = "/hot/resource/tool-specific-input/RecSNV/GRCh38/dbsnp_b150_grch38.vcf.gz"
    snp_mapq = 1
    snp_baq = 30
    depth = [25, 2500]
    cval = [25, 150]
    nbhdsnp = 250
    rnd_seed = 0
    no_cov_plot = true // setting this option to false could be memory intensive and has not been tested yet
    snp_count_orphans = true

    // BAF/LogR - BPG plot params for whole sample plotting
    // "index" - alleles plotted serially; "genome-position" - alleles plotted respective to genomic position
    position_scale = "genome-position" //"index" or "genome-position"

    bpg_plot_resolution = 200
    reference_dict = "/hot/resource/reference-genome/GRCh38-BI-20160721/Homo_sapiens_assembly38.dict"

    save_intermediate_files = false

    verbose = false

    min_rho = 0.1
    max_rho = 1.0
    min_psi = 1.6
    max_psi = 4.8

    min_goodness_of_fit = 0.63
    balanced_threshold = 0.51
    min_normal_depth = 10
    min_base_qual = 20
    min_map_qual = 35

    // Base resource allocation updater
    // See README for adding parameters to update the base resource allocations
    base_resource_update {
        memory = [['call_cnv_facets', 2]]
        }
    }

methods.setup()
